# Postgres (Neon). Create through Vercel > Storage > Neon, or neon.tech
DATABASE_URL=

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dunya-family

# Long random string: openssl rand -base64 48
SESSION_SECRET=

# Generate each with: npm run hash-password -- "the password"
FAMILY_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# Long random string for the calendar subscription link: openssl rand -hex 24
CALENDAR_TOKEN=

# Text reminders (Twilio). Leave blank until Twilio is set up; the site works without them and just won't text.
# From the Twilio console: Account Info on the home page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The texting number in +1 format, like +12125550143. Or use a Messaging Service SID instead (starts with MG).
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# The site's address as people should see it in texts, like https://dunya-family.com (no slash at the end)
SITE_URL=
# Long random string that lets the reminder schedule run: openssl rand -hex 24
CRON_SECRET=
